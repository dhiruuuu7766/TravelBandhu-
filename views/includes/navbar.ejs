<style>
  .btn-search {
    background-color: rgba(203, 19, 19, 0.847);
    color: white;
    border-radius: 25px;
  }

  .btn-search:hover {
    background-color: rgba(203, 19, 19, 0.847);
    color: white;
  }

  .btn-search i {
    display: inline-block;
    margin-right: 0.5rem;
  }
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
